<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="container contact-main">
    <div class="contact-copy">
      <p class="eyebrow">05 — Contact</p>
      <h2 id="contact-title">Have an idea?<br /><em>Let’s build it.</em></h2>
      <p>If you’d like to discuss a project or share an idea, we’d be glad to hear from you.</p>
    </div>
    <form class="contact-form" id="contact-form">
      <div class="form-heading">
        <p class="contact-label">Send a message</p>
        <a class="contact-phone" href="tel:+639158764715" aria-label="Call or message Gian Baldelovar at 0915 876 4715">
          <span>Call or message</span>
          <strong>0915 876 4715</strong>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="form-grid">
        <label>
          <span>Name</span>
          <input type="text" name="name" autocomplete="name" required placeholder="Your name" />
        </label>
        <label>
          <span>Email</span>
          <input type="email" name="email" autocomplete="email" required placeholder="you@example.com" />
        </label>
        <label class="message-field">
          <span>Message</span>
          <textarea name="message" rows="5" required placeholder="Tell me about your project"></textarea>
        </label>
      </div>
      <label class="form-trap" aria-hidden="true">
        Leave this field empty
        <input type="text" name="website" tabindex="-1" autocomplete="off" />
      </label>
      <button type="submit">
        <span>Send message</span>
        <span aria-hidden="true">↗</span>
      </button>
      <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<script>
  const contactForm = document.querySelector("#contact-form");
  const formStatus = document.querySelector("#form-status");

  contactForm?.addEventListener("submit", async (event) => {
    event.preventDefault();

    const form = event.currentTarget;
    if (!(form instanceof HTMLFormElement)) {
      return;
    }

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const data = new FormData(form);
    const name = String(data.get("name") ?? "").trim();
    const email = String(data.get("email") ?? "").trim();
    const message = String(data.get("message") ?? "").trim();
    const website = String(data.get("website") ?? "");
    const submitButton = form.querySelector('button[type="submit"]');

    if (formStatus) {
      formStatus.textContent = "Sending your message...";
    }

    if (submitButton instanceof HTMLButtonElement) {
      submitButton.disabled = true;
    }

    try {
      const response = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name, email, message, website }),
      });

      const contentType = response.headers.get("content-type") ?? "";
      if (!contentType.toLowerCase().includes("application/json")) {
        const isLocal = ["localhost", "127.0.0.1"].includes(window.location.hostname);
        throw new Error(
          isLocal
            ? "The contact API is not running. Start the site with `npx vercel dev` to test it locally."
            : "The contact service is unavailable right now. Please try again later.",
        );
      }

      const result = await response.json();
      if (!response.ok) {
        throw new Error(
          typeof result.message === "string" ? result.message : "Your message could not be sent. Please try again.",
        );
      }

      form.reset();
      if (formStatus) {
        formStatus.textContent = result.message;
      }
    } catch (error) {
      if (formStatus) {
        formStatus.textContent = error instanceof Error
          ? error.message
          : "Your message could not be sent. Please try again.";
      }
    } finally {
      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = false;
      }
    }
  });
</script>

<style>
  .contact {
    position: relative;
    overflow: hidden;
    padding: 100px 0 110px;
    background:
      linear-gradient(rgba(255,255,255,.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.055) 1px, transparent 1px),
      var(--accent-brown);
    background-size: 36px 36px;
    color: var(--white);
    scroll-margin-top: 78px;
  }
  .contact::before { content: ""; position: absolute; z-index: 0; inset: 0; background: url("/developer-devices.svg") no-repeat 5% 55% / min(74vw, 900px) auto; opacity: .3; filter: blur(5px); pointer-events: none; }
  .contact > .container { position: relative; z-index: 1; }
  .contact-main { min-height: 390px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: start; gap: 48px; }
  .contact-copy .eyebrow::before { background: var(--white); }
  .contact-copy h2 { margin: 0; font-family: "Manrope", sans-serif; font-size: clamp(54px, 5.2vw, 72px); line-height: .96; letter-spacing: -.07em; }
  .contact-copy h2 em { color: var(--white); font-family: Georgia, serif; font-weight: 400; }
  .contact-copy > p:last-child { max-width: 430px; margin: 26px 0 0; color: #f0e9e3; font-size: 16px; line-height: 1.7; }
  .contact-form { width: 100%; padding: 30px; border: 1px solid var(--white); background: var(--white); color: var(--ink); }
  .form-heading { display: flex; align-items: start; justify-content: space-between; gap: 24px; margin-bottom: 28px; }
  .contact-label { margin: 4px 0 0; font-size: 12px; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; }
  .contact-phone { display: grid; grid-template-columns: auto auto; gap: 3px 10px; min-width: 170px; padding: 0; text-align: right; }
  .contact-phone:hover { border-color: var(--accent-brown); opacity: .78; }
  .contact-phone:focus-visible { outline: 2px solid var(--accent-brown); outline-offset: 6px; }
  .contact-phone span:first-child { grid-column: 1; font-size: 11px; }
  .contact-phone strong { grid-column: 1; font-family: "Manrope", sans-serif; font-size: 16px; }
  .contact-phone span:last-child { grid-column: 2; grid-row: 1 / 3; align-self: center; font-size: 20px; }
  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .form-grid label { display: grid; gap: 8px; }
  .form-grid label span { font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
  .form-grid input, .form-grid textarea { width: 100%; border: 0; border-bottom: 1px solid rgba(33,27,23,.4); border-radius: 0; background: transparent; color: var(--ink); padding: 10px 0 12px; outline: none; }
  .form-grid textarea { resize: vertical; min-height: 112px; }
  .form-grid input::placeholder, .form-grid textarea::placeholder { color: var(--muted); }
  .form-grid input:focus, .form-grid textarea:focus { border-bottom-color: var(--accent-brown); box-shadow: 0 1px 0 var(--accent-brown); }
  .message-field { grid-column: 1 / -1; }
  .contact-form button { width: 100%; display: flex; justify-content: space-between; align-items: center; margin-top: 22px; border: 1px solid var(--white); background: var(--white); color: var(--accent-brown); padding: 14px 16px; font-weight: 800; cursor: pointer; transition: background 180ms ease, color 180ms ease; }
  .contact-form button:hover { background: var(--accent-brown); color: var(--white); }
  .contact-form button:focus-visible { outline: 2px solid var(--accent-brown); outline-offset: 4px; }
  .contact-form button:disabled { cursor: wait; opacity: .7; }
  .form-trap { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }
  .form-status { min-height: 18px; margin: 12px 0 0; font-size: 12px; color: var(--muted); }
  @media (max-width: 900px) {
    .contact-main { grid-template-columns: 1fr; gap: 36px; }
  }
  @media (max-width: 760px) {
    .contact { padding: 72px 0 80px; }
    .contact-main { min-height: 0; }
    .contact-copy h2 { font-size: clamp(42px, 12vw, 56px); }
    .contact-copy > p:last-child { margin-top: 20px; }
    .contact-form { padding: 24px; }
    .form-heading { align-items: center; }
  }
  @media (max-width: 380px) {
    .contact-copy h2 { font-size: 43px; }
    .form-heading { display: grid; }
    .contact-phone { justify-self: start; text-align: left; margin-top: 6px; }
    .form-grid { grid-template-columns: 1fr; }
  }
</style>
