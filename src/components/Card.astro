---
type Variant = "service" | "project" | "strength";

interface Props {
  variant: Variant;
  number: string;
  title: string;
  description: string;
  items?: readonly string[];
  image?: string;
}

const { variant, number, title, description, items = [], image } = Astro.props;
---

<article class:list={["card", `card--${variant}`]}>
  {variant === "service" && (
    <>
      <span class="card-number">{number}</span>
      <h3>{title}</h3>
      <p>{description}</p>
      <ul class="service-tags">
        {items.map((item) => <li>{item}</li>)}
      </ul>
    </>
  )}

  {variant === "project" && (
    <>
      <div class="project-meta"><span>PROJECT {number}</span><span>Selected work</span></div>
      <h3>{title}</h3>
      <p>{description}</p>
      <ul class="project-tags">
        {items.map((item) => <li>{item}</li>)}
      </ul>
    </>
  )}

  {variant === "strength" && (
    <>
      <span class="card-number">{number}</span>
      {image && (
        <figure class="profile-image">
          <img src={image} alt={title} />
        </figure>
      )}
      <h3>{title}</h3>
      <p>{description}</p>
      <ul class="strength-tags" aria-label={`Sample skills for ${title}`}>
        {items.map((item) => <li>{item}</li>)}
      </ul>
    </>
  )}
</article>

<style>
  .card--service {
    min-height: 310px;
    padding: 28px;
    border: 1px solid #6c6c6c;
    border-top: 3px solid var(--accent-brown);
    background: #080808;
    color: var(--white);
  }

  .card-number {
    display: inline-block;
    color: #c18b68;
    font-family: Consolas, monospace;
    font-size: 13px;
    font-weight: 700;
  }

  .card--service h3,
  .card--project h3,
  .card--strength h3 {
    margin: 34px 0 12px;
    font-family: "Manrope", sans-serif;
    font-size: 24px;
    letter-spacing: -.04em;
  }

  .card--service p,
  .card--project p,
  .card--strength p {
    margin: 0;
    font-size: 14px;
    line-height: 1.65;
  }

  .card--service p {
    color: #dedede;
  }

  .service-tags,
  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .service-tags li {
    padding: 7px 10px;
    border: 1px solid #777;
    color: #fff;
    font-size: 11px;
  }

  .card--project {
    min-height: 320px;
    padding: 30px;
    border: 1px solid var(--ink);
    background: var(--white);
    transition: transform 250ms ease, box-shadow 250ms ease;
  }

  .card--project:hover {
    transform: translateY(-5px);
    box-shadow: 8px 8px 0 var(--accent-brown);
  }

  .project-meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
    color: var(--accent-brown);
    font-family: Consolas, monospace;
    font-size: 11px;
    font-weight: 700;
  }

  .card--project h3 {
    margin-top: 34px;
  }

  .project-tags li {
    padding: 7px 10px;
    background: #f3eee9;
    color: var(--ink);
    font-size: 11px;
  }

  .card--strength {
    min-height: 240px;
    padding: 24px 26px 28px 0;
    border-right: 1px solid var(--line);
  }

  .card--strength + .card--strength {
    padding-left: 26px;
  }

  .card--strength:last-child {
    border-right: 0;
  }

  .card--strength h3 {
    margin: 16px 0 10px;
  }

  .card--strength p {
    max-width: 240px;
    color: var(--muted);
  }

  .profile-image {
    width: 100%;
    height: 300px;
    margin: 18px 0 0;
    overflow: hidden;
    border: 1px solid var(--line);
    background: #eee;
  }

  .profile-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .strength-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .strength-tags li {
    padding: 6px 8px;
    border: 1px solid var(--line);
    color: var(--ink);
    font-size: 10px;
  }

  @media (max-width: 850px) {
    .card--strength:nth-child(2n) {
      padding-left: 24px;
      border-right: 0;
    }

    .card--strength:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }

  @media (max-width: 600px) {
    .card--service,
    .card--project {
      min-height: 0;
      padding: 24px;
    }

    .card--strength,
    .card--strength + .card--strength,
    .card--strength:nth-child(2n) {
      min-height: 190px;
      padding: 24px 0;
      border-right: 0;
      border-top: 1px solid var(--line);
    }

    .card--strength h3 {
      margin-top: 32px;
    }
  }
</style>
